{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "skillListingBudgetFraction": 0.05,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "60000",
    "MAX_THINKING_TOKENS": "10000",
    "MCP_TIMEOUT": "30000",
    "MAX_MCP_OUTPUT_TOKENS": "25000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_AUTOCOMPACT_PCT_OVERRIDE": "85",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(bun:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker images:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(make:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform plan:*)",
      "Bash(hadolint:*)",
      "Bash(shellcheck:*)",
      "Bash(prettier:*)",
      "Bash(eslint:*)",
      "Bash(tsc:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue:*)",
      "Bash(gh repo:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(date:*)",
      "Bash(env:*)",
      "Bash(printenv:*)",
      "Bash(ruff:*)",
      "Bash(black:*)",
      "Bash(isort:*)",
      "Bash(mypy:*)",
      "Bash(pyright:*)",
      "Bash(goimports:*)",
      "Bash(golangci-lint:*)",
      "Bash(rustfmt:*)",
      "Bash(vitest:*)",
      "Bash(rubocop:*)",
      "Bash(phpcs:*)",
      "Bash(phpcbf:*)",
      "Bash(yamllint:*)",
      "Bash(sbt:*)",
      "Bash(scalafmt:*)",
      "Bash(scalafix:*)",
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(clang-format:*)",
      "Bash(clang-tidy:*)",
      "Bash(dart:*)",
      "Bash(flutter:*)",
      "Bash(mix:*)",
      "Bash(elixir:*)",
      "Bash(mvn:*)",
      "Bash(gradle:*)",
      "Bash(./gradlew:*)",
      "Bash(dotnet:*)",
      "Bash(kotlinc:*)",
      "Bash(ktlint:*)",
      "Bash(swift:*)",
      "Bash(swiftc:*)",
      "Bash(swiftformat:*)",
      "Bash(swiftlint:*)",
      "Bash(Rscript:*)",
      "Bash(perl:*)",
      "Bash(perltidy:*)",
      "Bash(perlcritic:*)",
      "Bash(prove:*)",
      "Bash(luacheck:*)",
      "Bash(stylua:*)",
      "Bash(busted:*)",
      "Bash(gfortran:*)",
      "Bash(fprettify:*)",
      "Bash(fpm:*)",
      "Bash(gnat:*)",
      "Bash(gnatpp:*)",
      "Bash(gprbuild:*)",
      "Bash(alr:*)",
      "Bash(cobc:*)",
      "Bash(fpc:*)",
      "Bash(lazbuild:*)",
      "Bash(octave:*)",
      "Bash(nasm:*)",
      "Bash(sqlfluff:*)",
      "Bash(sql-formatter:*)",
      "Bash(rtk:*)",
      "Bash(/home/vscode/.claude/scripts/*:*)",
      "Read(**/*)",
      "Glob(**/*)",
      "Grep(**/*)",
      "mcp__context7__*",
      "Write(.claude/**)",
      "Write(.devcontainer/**)",
      "Write(.github/**)",
      "Write(.githooks/**)",
      "Edit(.claude/**)",
      "Edit(.devcontainer/**)",
      "Edit(.github/**)",
      "Edit(.githooks/**)"
    ],
    "deny": [],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": []
  },
  "enableAllProjectMcpServers": true,
  "disabledMcpjsonServers": [],
  "statusLine": {
    "type": "command",
    "command": "status-line"
  },
  "outputStyle": "default",
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "promptSuggestionEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "worktree": {
    "baseRef": "head"
  }
}
